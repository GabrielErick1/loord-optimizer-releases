{
  "name": "loord-optimizer",
  "version": "3.4.6",
  "author": "Loord Optimizer",
  "description": "Loord Optimizer - Otimizador Gamer de Sensibilidade e Emulador",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "obfuscate": "node scripts/obfuscate.js backup-and-obfuscate",
    "restore": "node scripts/obfuscate.js restore",
    "package": "electron-packager . \"Loord Optimizer\" --platform=win32 --arch=x64 --overwrite --win32metadata.requested-execution-level=requireAdministrator --ignore=FFOptimizer-win32-x64 --ignore=\"Loord Optimizer-win32-x64\" --ignore=FFOptimizer_Novo --ignore=BlueStacks_nxt --ignore=BlueStacks_msi5 --ignore=dist",
    "dist": "node scripts/obfuscate.js backup-and-obfuscate && electron-builder --win && node scripts/obfuscate.js restore",
    "publish": "node scripts/obfuscate.js backup-and-obfuscate && electron-builder --win --publish always && node scripts/obfuscate.js restore"
  },
  "build": {
    "appId": "com.loord.optimizer",
    "productName": "Loord Optimizer",
    "asar": true,
    "asarUnpack": [
      "bin/**"
    ],
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "i18n.js",
      "index.html",
      "style.css",
      "package.json",
      "bin/**",
      "clean_ram.ps1",
      "otimizar_processos.ps1",
      "macro_capa.ps1",
      "regis/encrypted_reg_data.js",
      "melhor regis/**"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "perMachine": true,
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "GabrielErick1",
        "repo": "loord-optimizer-releases",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2",
    "javascript-obfuscator": "^5.6.0"
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  }
}
